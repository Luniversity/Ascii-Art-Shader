# Unity .gitattributes Template
# Source: https://github.com/gitattributes/gitattributes/blob/master/Unity.gitattributes
# Last synced: 2026-02-04
# License: MIT
#
# Adapted for this repository, where the Unity project lives in "My project".

* text=auto

# Project documentation and ReShade source use stable line endings.
*.md                    text eol=lf
*.fx                    text eol=lf linguist-language=hlsl
*.gitignore             text eol=lf
*.gitattributes         text eol=lf
LICENSE                 text eol=lf
# Define macros (only works in top-level gitattributes files)
[attr]binary-file       -diff -merge -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml
# Unity source files
*.cginc                 text
*.compute               text linguist-language=hlsl
*.cs                    text diff=csharp
*.hlsl                  text linguist-language=hlsl
*.raytrace              text linguist-language=hlsl
*.shader                text
# Unity JSON files
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions          unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json
# Unity UI Toolkit files
*.tss                   text diff=css linguist-language=css
*.uss                   text diff=css linguist-language=css
*.uxml                  text linguist-language=xml linguist-detectable
# Unity YAML files
*.anim                  unity-yaml
*.asset                 unity-yaml
*.brush                 unity-yaml
*.controller            unity-yaml
*.flare                 unity-yaml
*.fontsettings          unity-yaml
*.giparams              unity-yaml
*.guiskin               unity-yaml
*.lighting              unity-yaml
*.mask                  unity-yaml
*.mat                   unity-yaml
*.meta                  unity-yaml
*.mixer                 unity-yaml
*.overrideController    unity-yaml
*.playable              unity-yaml
*.prefab                unity-yaml
*.preset                unity-yaml
*.renderTexture         unity-yaml
*.scenetemplate         unity-yaml
*.shadervariants        unity-yaml
*.signal                unity-yaml
*.spriteatlas           unity-yaml
*.spriteatlasv2         unity-yaml
*.terrainlayer          unity-yaml
*.unity                 unity-yaml
# "physic" for 3D but "physics" for 2D
*.physicMaterial        unity-yaml
*.physicsMaterial2D     unity-yaml
# Exclude generated or third-party files from GitHub stats and diffs
"My project/Assets/Plugins/**"            linguist-generated
"My project/Packages/packages-lock.json"  linguist-generated
# Unity binary files
*.cubemap               binary-file
*.unitypackage          binary-file
